# Copy to .env (or export these in your shell) before running.

# Required for live AI runs. Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Where job outputs are written (default: house_design_studio/jobs)
# HDS_DATA_DIR=/absolute/path/to/jobs

# Path to FreeCADCmd if it is not on your PATH, e.g.
# HDS_FREECAD_CMD=C:\Program Files\FreeCAD 1.0\bin\FreeCADCmd.exe

# Max revision-loop iterations (default 5)
# HDS_MAX_ITERATIONS=5

# --- Offline / development flags ---
# Force the pure-Python geometry builder instead of FreeCAD:
# HDS_DEV_MODE_SKIP_FREECAD=1
# Use scripted AI responses so the app runs with NO API key (demo/CI):
# HDS_DEV_MODE_MOCK_CLAUDE=1
